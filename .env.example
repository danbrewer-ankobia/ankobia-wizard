# Copy to .env.local for local development. Never commit real values.

# Admin sign-in for /admin (interim, until Microsoft Entra sign-in is added).
ADMIN_PASSWORD=change-me
# 16+ random characters. Signs admin sessions and encrypts stored API keys.
# Changing it makes previously saved keys unreadable (re-enter them in /admin).
ADMIN_SECRET=generate-with-openssl-rand-hex-32

# Optional fallback Claude key, used when no key is saved in admin settings.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: where admin settings and the edited prompt library are stored.
# Defaults to ./data (gitignored). Point at a persistent volume in production.
# DATA_DIR=/var/lib/ankobia-wizard
